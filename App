import java.util.Scanner;
public class App {
    
    public static void main(String[] args) throws Exception {
        boolean validateEntry = false;
        loggedInSession sesh = new loggedInSession();
        user currentUser = null;
        Scanner sc = new Scanner(System.in);
        System.out.println("Hello, World!");
        String input = null;
        bankingBackend bank = new bankingBackend();
    
        while(true){
        
            System.out.println("Log in - Create User - Exit");
            input = sc.nextLine();
            boolean validate = false;

            switch (input.toLowerCase()){
            case "log in":
                validateEntry = false;
                int count = 0;
                do{
                      System.out.println("Enter email: ");
                String eMail = sc.nextLine();
                
                System.out.println("Enter password: ");
                String passW = sc.nextLine();
                    //will always pass but will always come back to if password or email is wrong
                currentUser = bank.getUser(eMail);
                    //so when you enter it'll do the if statement, otherwise you'll just be waiting lol
                /*object object name = something holding your data.accessor data(paramater for data ) */
                if(currentUser !=null  && 
                    passW.equals(currentUser.getPassword())){
                     System.out.println("Log in successful! ");
                    validateEntry = true;
                    
                    sesh.theSession(sc, bank, currentUser);
                    currentUser = null;//null because if you don't have it as null then you'll be logged in forever.

                } else{
                    System.out.println("Invalid email or password");
                    count++;
                    if(count==3){
                        System.out.println("Too many failed attempts");
                        break;
                    }
                    //after this, the program will go back to the top and ask again with a new count value
                }
               
                }while(count < 3 && !validateEntry);
                break;

            case "create user":
                while(!validate){
                    System.out.println("Enter username: (First Last, online, etc.)");
                    String user = sc.nextLine();

                    while(user.isBlank()){
                          System.out.println("Invalid, user cannot be empty  ");
                    user = sc.nextLine();
                    }
                    
                    System.out.print("Enter an email: ");
                    String email = sc.nextLine();
                    while(!email.contains("@")){
                          System.out.println("Invalid, email cannot be empty");
                          System.out.println("Re-enter email: ");
                    email = sc.nextLine();
                    }

                    while(true){
                        System.out.print("Enter a password: ");
                        String pass = sc.nextLine();

                        if(pass.isBlank()){
                            System.out.println("Password cannot be empty");
                            continue; 
                        }

                        /*everything after this will just keep asking for a valid password 
                        It will break the while and validate is true when you finally have a correct password
                        */
                        validate = bank.createUser(user,email,pass);
                        
                        if(validate){
                            System.out.println("Successfully created account!");
                            break;
                        } else {
                             System.out.println("Invalid data (email exists or password rules not met). Try again password.");
                        }
                    }
                }
                break;
            case "exit":
                System.out.println("Thank you for using us!");
                return;
            default: 
                System.out.println("Please enter a valid action or type exit");
                break;
        }
        //after u log in, what can they do?
       
    }
      
    } 

}
