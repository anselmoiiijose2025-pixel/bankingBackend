     public boolean createUser(String theName, String theEmail, String thePassword) throws InvalidEmailException{
        if(users.containsKey(theEmail)){
            System.out.println("Sorry this email already exists");
        return false;
        }
        String domain = theEmail.substring(theEmail.indexOf("@"));
        if(!domain.equals("@gmail.com") &&
    !domain.equals("@yahoo.com") && 
    !domain.equals("@outlook.com") &&
    !domain.equals("@icloud.com") &&
    !domain.equals("@hotmail.com")){
          System.out.println("Inavalid Email Expression");
          return false;
        }
        if(thePassword.length() < 10){
            System.out.println("Password does not meet the requirements");
            //throw new InvalidPasswordException("Password does not meet the requirements");
            //return false; //will return false if any variables are incorrect
            return false;
        }
        user newUser = new user(theName, thePassword, theEmail);
        users.put(theName,newUser);
        return true;
     }
     
