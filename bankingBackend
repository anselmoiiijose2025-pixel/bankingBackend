    public void saveUsers(){
        try{
            FileOutputStream fileOut = new FileOutputStream("users.dat");//the file we're making
            ObjectOutputStream objectOut = new ObjectOutputStream(fileOut);//the writer

            objectOut.writeObject(users);
            objectOut.writeObject(transactions);

            objectOut.close();
            fileOut.close();
            
        System.out.println("Saved users successfully");
        }catch(Exception e){
            System.out.println("Error occured while saving users ");
        }
    }
