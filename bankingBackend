    public void loadUsers(){
        try{
            FileInputStream fileIn = new FileInputStream("users.dat");//the file we're grabbing
            ObjectInputStream objectIn = new ObjectInputStream(fileIn); //the writer

            users = (HashMap<String, user>) objectIn.readObject();
            
